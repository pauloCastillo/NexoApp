        A2["Capturar ubicación GPS"]
        A16["Mostrar resumen:<br>horas normales + extra"]
  end
 subgraph LANE_APP["⚙️ Time-Tracking Use Case"]
        A3{"¿Dentro del<br>geofence?"}    
