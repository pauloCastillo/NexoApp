        A18["Calcular pago estimado<br>= horas x tarifa x multiplicador"]
        A19{"¿Horas extra superan<br>límite legal/política<br>de la empresa?"}
        A20["Generar alerta para<br>Manager: aprobación<br>requerida"]
        A21["Persistir TimeEntry<br>con desglose:<br>regular / overtime"]
        A22["Actualizar totales<br>en Timesheet del periodo"]
        A23["Publicar evento<br>TimeEntryCompleted"]
  end
 subgraph LANE_NOTIF["🔔 Notification Service"]
